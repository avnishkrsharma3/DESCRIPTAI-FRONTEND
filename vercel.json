{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/login$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|whatsapp|telegrambot|discordbot|pinterest|googlebot"
        }
      ],
      "dest": "/api/og-login"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
